// ============================================================================
// DAX MEASURES LIBRARY FOR POWER BI
// Model: Sales Analytics Star Schema
// Fact Table: fact_sales
// Dimensions: dim_date, dim_customers, dim_products, dim_regions
// ============================================================================

// ----------------------------------------------------------------------------
// 1. CORE FINANCIAL & OPERATIONAL KPIS
// ----------------------------------------------------------------------------

Total Revenue = 
SUM(fact_sales[sales])

Total Profit = 
SUM(fact_sales[profit])

Total Cost = 
SUM(fact_sales[total_cost])

Profit Margin % = 
DIVIDE(
    [Total Profit], 
    [Total Revenue], 
    0
)

Total Orders = 
DISTINCTCOUNT(fact_sales[order_id])

Total Units Sold = 
SUM(fact_sales[quantity])

Average Order Value (AOV) = 
DIVIDE(
    [Total Revenue], 
    [Total Orders], 
    0
)

Average Discount % = 
AVERAGE(fact_sales[discount])

Average Delivery Days = 
AVERAGE(fact_sales[delivery_days])


// ----------------------------------------------------------------------------
// 2. TIME INTELLIGENCE & PERIOD-OVER-PERIOD GROWTH
// ----------------------------------------------------------------------------

Revenue Prior Month (PM) = 
CALCULATE(
    [Total Revenue], 
    DATEADD(dim_date[date_id], -1, MONTH)
)

MoM Revenue Growth $ = 
[Total Revenue] - [Revenue Prior Month (PM)]

MoM Revenue Growth % = 
DIVIDE(
    [MoM Revenue Growth $], 
    [Revenue Prior Month (PM)], 
    BLANK()
)

Revenue Prior Year (PY) = 
CALCULATE(
    [Total Revenue], 
    SAMEPERIODLASTYEAR(dim_date[date_id])
)

YoY Revenue Growth $ = 
[Total Revenue] - [Revenue Prior Year (PY)]

YoY Revenue Growth % = 
DIVIDE(
    [YoY Revenue Growth $], 
    [Revenue Prior Year (PY)], 
    BLANK()
)

Profit Prior Year (PY) = 
CALCULATE(
    [Total Profit], 
    SAMEPERIODLASTYEAR(dim_date[date_id])
)

YoY Profit Growth % = 
DIVIDE(
    [Total Profit] - [Profit Prior Year (PY)], 
    [Profit Prior Year (PY)], 
    BLANK()
)

Revenue YTD = 
TOTALYTD(
    [Total Revenue], 
    dim_date[date_id]
)

Profit YTD = 
TOTALYTD(
    [Total Profit], 
    dim_date[date_id]
)

Rolling 3-Month Revenue = 
CALCULATE(
    [Total Revenue],
    DATESINPERIOD(
        dim_date[date_id],
        LASTDATE(dim_date[date_id]),
        -3,
        MONTH
    )
)


// ----------------------------------------------------------------------------
// 3. PRODUCT & CATEGORY ANALYTICS
// ----------------------------------------------------------------------------

Category Revenue Contribution % = 
DIVIDE(
    [Total Revenue],
    CALCULATE([Total Revenue], ALL(dim_products[category])),
    0
)

SubCategory Revenue Rank = 
RANKX(
    ALL(dim_products[sub_category]), 
    [Total Revenue], 
    , 
    DESC, 
    Dense
)

Top 10 Product Revenue Filter = 
VAR RankedProducts = 
    RANKX(
        ALLSELECTED(dim_products[product_name]), 
        [Total Revenue], 
        , 
        DESC
    )
RETURN 
    IF(RankedProducts <= 10, [Total Revenue], BLANK())

Loss-Making Transactions Count = 
CALCULATE(
    COUNTROWS(fact_sales),
    fact_sales[profit] < 0
)

Loss-Making Transactions % = 
DIVIDE(
    [Loss-Making Transactions Count],
    COUNTROWS(fact_sales),
    0
)


// ----------------------------------------------------------------------------
// 4. REGIONAL & LOGISTICS PERFORMANCE
// ----------------------------------------------------------------------------

Regional Revenue Contribution % = 
DIVIDE(
    [Total Revenue],
    CALCULATE([Total Revenue], ALL(dim_customers[region])),
    0
)

SLA On-Time Shipments Count = 
CALCULATE(
    COUNTROWS(fact_sales),
    fact_sales[delivery_days] <= 5
)

SLA Delivery Compliance Rate % = 
DIVIDE(
    [SLA On-Time Shipments Count],
    COUNTROWS(fact_sales),
    0
)


// ----------------------------------------------------------------------------
// 5. CUSTOMER PERFORMANCE & VALUE
// ----------------------------------------------------------------------------

Unique Customer Count = 
DISTINCTCOUNT(fact_sales[customer_id])

Revenue Per Customer = 
DIVIDE(
    [Total Revenue],
    [Unique Customer Count],
    0
)

High-Value Orders Count = 
CALCULATE(
    COUNTROWS(fact_sales),
    fact_sales[sales] >= 1000
)

High-Value Orders Revenue = 
CALCULATE(
    [Total Revenue],
    fact_sales[sales] >= 1000
)


// ----------------------------------------------------------------------------
// 6. DYNAMIC KPI STATUS & FORMATTING CONDITIONAL RULES
// ----------------------------------------------------------------------------

Margin Health Status KPI = 
SWITCH(
    TRUE(),
    [Profit Margin %] >= 0.20, "Healthy (>= 20%)",
    [Profit Margin %] >= 0.15, "Moderate (15-20%)",
    [Profit Margin %] >= 0.05, "Low Margin (5-15%)",
    "Critical / Negative (< 5%)"
)

KPI Margin Color Indicator = 
SWITCH(
    TRUE(),
    [Profit Margin %] >= 0.20, "#2E7D32", // Green
    [Profit Margin %] >= 0.15, "#0288D1", // Blue
    [Profit Margin %] >= 0.10, "#ED6C02", // Orange
    "#D32F2F"                             // Red
)
